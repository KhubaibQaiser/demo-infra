{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["lib", "keepalive/src", "cdk", "scripts", "keepalive/gen-wrangler.ts", "keepalive/test", "cdk/test"],
  "exclude": ["node_modules", "cdk.out"]
}
